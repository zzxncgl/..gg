-- ================== CAPTURA DE PALABRAS Y ENVIO ==================
local submitNow, deliverCode, pushWord

local function combineParts(parts)
    for _, p in ipairs(parts) do
        if p:find("%s") then return table.concat(parts, " ") end
    end
    return table.concat(parts)
end

local function appendToBox(word)
    if not word or word == "" then return end
    if _lastWatchedBox and not isVisibleChain(_lastWatchedBox) then
        resetCapture()
        clearBoxWatchers()
    end
    capturedParts[#capturedParts + 1] = word
    local combined = combineParts(capturedParts)
    local count = #capturedParts

    local box = findCodeBox()
    if box then
        _lastBox = box
        watchBoxForBlankReset(box)
        local wasFocused = UserInputService:GetFocusedTextBox() == box
        pcall(function() box.Text = combined end)
        if wasFocused then
            pcall(function()
                box.CursorPosition = #combined + 1
                box.SelectionStart = #combined + 1
            end)
        end
    else
        setStatus("Capturado; abriendo el menu de codigos...", COLORS.Text)
    end

    setStatus("Palabra " .. count .. "/" .. _words, COLORS.Green)
    flashCode(combined, COLORS.Green)

    if count >= _words then
        capturedParts = {}
        if _autoSubmit then submitNow(box, combined) end
    end
end

pushWord = function(word)
    word = trim(word)
    if word == "" or _seen[word] then return end
    _seen[word] = true
    task.delay(1.25, function() _seen[word] = nil end)
    appendToBox(word)
end

submitNow = function(box, code)
    rememberPendingSubmission(box, code, true)
    local ok, msg = typeAndSubmitCode(code)
    if ok then
        setStatus("Enviado: " .. code, COLORS.Green)
    else
        local restored = restoreRejectedText(box, code)
        clearPendingSubmission()
        if restored then
            setStatus("No se pudo enviar - repegado: " .. code, COLORS.Text)
            flashCode(code, COLORS.Red)
        else
            setStatus("Fallo: " .. tostring(msg), COLORS.Red)
        end
    end
end

-- Respuesta lista (acertijo): se pega entera y se envia segun "Auto enviar"
deliverCode = function(code)
    local box = findCodeBox()
    if box then
        _lastBox = box
        pasteText(box, code)
    end
    flashCode(code, COLORS.Green)
    if _autoSubmit then
        submitNow(box, code)
    else
        setStatus("Pegado (auto enviar OFF): " .. code, COLORS.Text)
    end
end

-- ================== IA PARA ACERTIJOS ==================
local httpRequest = (syn and syn.request) or (http and http.request) or request or http_request

local function httpPost(url, headers, bodyTable)
    if not httpRequest then return nil, "tu ejecutor no tiene request" end
    local ok, res = pcall(httpRequest, {
        Url = url,
        Method = "POST",
        Headers = headers,
        Body = HttpService:JSONEncode(bodyTable),
    })
    if not ok or type(res) ~= "table" then return nil, "sin respuesta del servidor" end
    local raw = res.Body or res.body
    if type(raw) ~= "string" then return nil, "respuesta vacia" end
    local okd, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if okd and type(data) == "table" then return data end
    return nil, "respuesta invalida"
end

local function cleanAnswer(s)
    s = trim(s)
    s = (s:gsub("^[%p%s]+", ""))
    s = (s:gsub("[%p%s]+$", ""))
    return s
end

-- devuelve: respuesta, esAcertijo, error
local function aiSolve(message)
    local A = CFG.AI
    if A.AnthropicKey ~= "" then
        local data, err = httpPost("https://api.anthropic.com/v1/messages", {
            ["Content-Type"] = "application/json",
            ["x-api-key"] = A.AnthropicKey,
            ["anthropic-version"] = "2023-06-01",
        }, {
            model = A.AnthropicModel,
            max_tokens = 60,
            system = A.SystemPrompt,
            messages = { { role = "user", content = message } },
        })
        if not data then return nil, false, err end
        local text = data.content and data.content[1] and data.content[1].text
        if type(text) ~= "string" then return nil, false, "la IA no respondio" end
        if text:upper():find("NOT_RIDDLE", 1, true) then return nil, false end
        local ans = cleanAnswer(text)
        if ans == "" then return nil, true end
        return ans, true
    end

    local data, err = httpPost(A.WorkerURL .. "/solve", {
        ["Content-Type"] = "application/json",
        ["Authorization"] = "Bearer " .. A.WorkerToken,
    }, { message = message, model = A.WorkerModel, history = {} })
    if not data then return nil, false, err end
    if data.riddle ~= true then return nil, false end
    local first = type(data.answers) == "table" and data.answers[1] or ""
    local ans = cleanAnswer(first)
    if ans == "" then return nil, true end
    return ans, true
end

local function solveRiddle(message, seq)
    _solving = _solving + 1
    setStatus("IA resolviendo acertijo...", COLORS.Text)
    task.spawn(function()
        local ans, isRiddle, err = aiSolve(message)
        _solving = math.max(0, _solving - 1)
        if not running or not _enabled then return end
        if ans and _riddle then
            if seq < _lastAnswered then return end -- ya se respondio uno mas nuevo
            _lastAnswered = seq
            setStatus("Respuesta IA: " .. ans, COLORS.Green)
            deliverCode(ans)
        elseif _remember then
            -- no era acertijo (o la IA fallo): con Code remember se pega todo lo que dice
            pushWord(message)
        else
            setStatus(err and ("IA: " .. err) or "IA: sin respuesta", COLORS.Red)
        end
    end)
end

-- ================== ANUNCIOS ==================
-- Saca el texto del primer argumento (acepta texto, numeros y tablas)
local function argText(v, depth)
    local t = typeof(v)
    if t == "string" then return v end
    if t == "number" then return tostring(v) end
    if t == "table" and depth < 3 then
        for _, k in ipairs({ "Text", "text", "Message", "message", "Content", "content", "Title", "title", "Body", "body" }) do
            local x = v[k]
            if type(x) == "string" or type(x) == "number" then return tostring(x) end
        end
        for _, x in ipairs(v) do
            local s = argText(x, depth + 1)
            if s ~= "" then return s end
        end
    end
    return ""
end

local function extractText(...)
    for i = 1, select("#", ...) do
        local s = argText((select(i, ...)), 0)
        if trim(s) ~= "" then return s end
    end
    return ""
end

local function onAnnouncement(...)
    local text = trim(stripRich(extractText(...)))
    if text == "" then return end

    if text:find("%s") then
        -- varias palabras: acertijo (IA) o texto completo (Code remember)
        if _riddle then
            _riddleSeq = _riddleSeq + 1
            solveRiddle(text, _riddleSeq)
        elseif _remember then
            pushWord(text)
        end
        return
    end

    -- una sola palabra, letra o numero: cuenta como una palabra
    local token = text:gsub("^[^%w]+", "")
    token = token:gsub("[^%w]+$", "")
    if token == "" then return end
    pushWord(token)
end

local function sourceLooksLikeNotifications(fn)
    local getinfo = debug and debug.getinfo
    if getinfo then
        local ok, info = pcall(getinfo, fn)
        if ok and type(info) == "table" then
            if tostring(info.short_src or info.source or ""):find("NotificationController", 1, true) then
                return true
            end
        end
    end
    local okEnv, env = pcall(getfenv, fn)
    if okEnv and type(env) == "table" then
        local okS, scr = pcall(function() return rawget(env, "script") end)
        if okS and typeof(scr) == "Instance" and scr.Name:find("NotificationController", 1, true) then
            return true
        end
    end
    return false
end

local function resolveNotifyRemote()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local Packages = ReplicatedStorage:WaitForChild("Packages", 3)
    local Net = Packages and Packages:WaitForChild("Net", 3)
    if not Net or typeof(getconns) ~= "function" then return nil end
    for _, d in ipairs(Net:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local ok, cs = pcall(getconns, d.OnClientEvent)
            if ok and type(cs) == "table" then
                for _, c in ipairs(cs) do
                    local f, fn = pcall(function() return c.Function end)
                    if f and type(fn) == "function" and sourceLooksLikeNotifications(fn) then
                        return d
                    end
                end
            end
        end
    end
    return nil
end

local listenConn
task.spawn(function()
    local remote
    for attempt = 1, 12 do
        if not running then return end
        remote = resolveNotifyRemote()
        if remote then break end
        if attempt == 1 then setStatus("Buscando el remoto de anuncios...", COLORS.Dim) end
        task.wait(5)
    end
    if not remote then
        setStatus("No encontre el remoto de anuncios. Define _G.PhiNotifyRemote y vuelve a ejecutar.", COLORS.Red)
        return
    end
    listenConn = remote.OnClientEvent:Connect(function(...)
        if not _enabled then return end
        pcall(onAnnouncement, ...)
    end)
    setStatus("Escuchando anuncios", COLORS.Green)
end)

if getgenv then
    getgenv().StopNebulaCodeSniper = function()
        running = false
        if listenConn then pcall(function() listenConn:Disconnect() end) listenConn = nil end
        clearBoxWatchers()
        stopFeedbackWatch()
        for _, c in ipairs(globalConns) do pcall(function() c:Disconnect() end) end
        if viewportConnection then pcall(function() viewportConnection:Disconnect() end) end
        if GUI then GUI:Destroy() end
    end
end
