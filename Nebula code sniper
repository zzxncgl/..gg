-- ---------- arrastrar la ventana (mouse y tactil) ----------
do
    local dragging = false
    local activeDragInput, dragStart, startPosition
    local dragMoved = false
    local DRAG_THRESHOLD = UserInputService.TouchEnabled and 10 or 3

    local function isOverToggle(pos)
        local p, s = MainToggle.AbsolutePosition, MainToggle.AbsoluteSize
        return pos.X >= p.X - 10 and pos.X <= p.X + s.X + 10
            and pos.Y >= p.Y - 10 and pos.Y <= p.Y + s.Y + 10
    end

    local function stopDragging(input)
        if input ~= activeDragInput then return end
        dragging = false
        activeDragInput, dragStart, startPosition = nil, nil, nil
    end

    Header.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if dragging or isOverToggle(input.Position) then return end
        dragging = true
        activeDragInput = input
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPosition = Window.Position
        dragMoved = false
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End
                or input.UserInputState == Enum.UserInputState.Cancel then
                stopDragging(input)
            end
        end)
    end)

    track(UserInputService.InputChanged:Connect(function(input)
        if not dragging or not activeDragInput then return end
        local okTouch = activeDragInput.UserInputType == Enum.UserInputType.Touch and input == activeDragInput
        local okMouse = activeDragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        if not okTouch and not okMouse then return end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
        if not dragMoved then
            if delta.Magnitude < DRAG_THRESHOLD then return end
            dragMoved = true
        end
        Window.Position = UDim2.new(
            startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
        )
    end))
end

-- ================== VIGILAR LA CAJA DE CODIGOS ==================
local _lastWatchedBox, _boxTextConn, _boxAncestryConn
local _lastNonBlankBoxText = ""

local function clearBoxWatchers()
    if _boxTextConn then pcall(function() _boxTextConn:Disconnect() end) end
    if _boxAncestryConn then pcall(function() _boxAncestryConn:Disconnect() end) end
    _boxTextConn, _boxAncestryConn, _lastWatchedBox = nil, nil, nil
end

local function watchBoxForBlankReset(box)
    if not box or _lastWatchedBox == box then return end
    clearBoxWatchers()
    _lastWatchedBox = box
    if box.Text ~= "" then _lastNonBlankBoxText = box.Text end
    _boxTextConn = box:GetPropertyChangedSignal("Text"):Connect(function()
        if box.Text == "" then resetCapture() else _lastNonBlankBoxText = box.Text end
    end)
    _boxAncestryConn = box.AncestryChanged:Connect(function(_, parent)
        if not parent then resetCapture() clearBoxWatchers() end
    end)
end

-- ================== REINTENTAR INVALIDO ==================
local _pendingText, _pendingBox, _pendingUntil, _pendingToken = nil, nil, 0, 0
local feedbackConns = {}

local function stopFeedbackWatch()
    for _, c in ipairs(feedbackConns) do pcall(function() c:Disconnect() end) end
    feedbackConns = {}
end

local function clearPendingSubmission()
    _pendingToken = _pendingToken + 1
    _pendingText, _pendingBox, _pendingUntil = nil, nil, 0
    stopFeedbackWatch()
end

local function restoreRejectedText(box, previousText)
    if not _retype or not previousText or previousText == "" then return false end
    RunService.Heartbeat:Wait()
    local target = findCodeBox() or box
    if not target or not isVisibleChain(target) then return false end
    local ok = pcall(function() target.Text = previousText end)
    if ok then
        _lastBox = target
        watchBoxForBlankReset(target)
    end
    return ok
end

local REJECT_WORDS = {
    "invalid code", "code is invalid", "invalid", "expired", "already redeemed",
    "already used", "doesn't exist", "does not exist", "not found", "rejected",
    "invalido", "expirado", "ya canjeado",
}

local function handleRedemptionFeedback(text, obj)
    if not _retype or not _pendingText then return end
    if os.clock() > _pendingUntil then clearPendingSubmission() return end
    if obj and isOurGui(obj) then return end
    local lower = tostring(text or ""):lower()
    local rejected = false
    for _, w in ipairs(REJECT_WORDS) do
        if lower:find(w, 1, true) then rejected = true break end
    end
    if not rejected then return end
    local prevText, prevBox = _pendingText, _pendingBox
    local restored = restoreRejectedText(prevBox, prevText)
    clearPendingSubmission()
    if restored then
        setStatus("Invalido - repegado: " .. prevText, COLORS.Text)
        flashCode(prevText, COLORS.Red)
    end
end

local function watchFeedbackObject(obj, handleNow)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) or isOurGui(obj) then return end
    if handleNow then handleRedemptionFeedback(obj.Text or "", obj) end
    feedbackConns[#feedbackConns + 1] = obj:GetPropertyChangedSignal("Text"):Connect(function()
        handleRedemptionFeedback(obj.Text or "", obj)
    end)
end

local function startFeedbackWatch()
    stopFeedbackWatch()
    for _, o in ipairs(playerGui:GetDescendants()) do watchFeedbackObject(o, false) end
    feedbackConns[#feedbackConns + 1] = playerGui.DescendantAdded:Connect(function(o)
        task.wait(0.04)
        watchFeedbackObject(o, true)
    end)
end

local function rememberPendingSubmission(box, text, replaceExisting)
    if not _retype or not text or text == "" then return end
    if not replaceExisting and _pendingText and os.clock() <= _pendingUntil then return end
    _pendingToken = _pendingToken + 1
    local token = _pendingToken
    _pendingText, _pendingBox, _pendingUntil = text, box, os.clock() + 8
    startFeedbackWatch()
    task.delay(8, function()
        if token == _pendingToken then clearPendingSubmission() end
    end)
end

